rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read listings (flights/hotels/packages/umrah shown on the
    // public Results page). Only a signed-in admin can create/edit/delete.
    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Homepage "Best Holiday Packages" cards.
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
